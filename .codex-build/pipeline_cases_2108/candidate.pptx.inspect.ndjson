{"kind":"textbox","id":"sh/5sfepcfe","slideIndex":0,"position":{"left":60,"top":797,"width":720,"height":40},"name":"angle-formula","text":"MAEθ = (1/Nθ) ∑ᵢ |θ̂ᵢ − θᵢ|    （°）","geometry":"rect","lineWidth":0,"style":{"fontSize":27,"typeface":"Microsoft YaHei","color":"#102B46","alignment":"left"}}
{"kind":"textbox","id":"sh/ipovexwn","slideIndex":0,"position":{"left":60,"top":839,"width":710,"height":29},"name":"angle-definition","text":"θ = arccos[(u·v)/(‖u‖‖v‖)] × 180/π","geometry":"rect","lineWidth":0,"style":{"fontSize":21,"typeface":"Microsoft YaHei","color":"#526575","alignment":"left"}}
{"kind":"textbox","id":"sh/3qxwn2x8","slideIndex":0,"position":{"left":810,"top":797,"width":735,"height":40},"name":"ratio-formula","text":"MREᵣ = (100/Nᵣ) ∑ⱼ |r̂ⱼ/rⱼ − 1|    （%）","geometry":"rect","lineWidth":0,"style":{"fontSize":27,"typeface":"Microsoft YaHei","color":"#102B46","alignment":"left"}}
